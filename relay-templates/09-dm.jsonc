// A private-message inbox, alice-dm: anyone may drop a gift wrap, only members
// read them. Wraps carry no author, so an allow list of just the wrap kind and
// profiles keeps everything else out.
{
  "$schema": "https://bind.ws/relay-config.schema.json",
  "format": "bind.ws/relay-config/2",
  "template": {
    "title": "DM inbox",
    "about": "An inbox for private messages. Anyone drops gift wraps, only members read them. Nothing else is accepted."
  },
  "policy": {
    "writes": "open",
    "reads": "members",
    "directoryPublic": false
  },
  "kinds": {
    "allow": [
      0,
      1059
    ],
    "block": []
  },
  "retention": [],
  "connections": [
    {"template": "dm", "visibility": "public"}
  ]
}
