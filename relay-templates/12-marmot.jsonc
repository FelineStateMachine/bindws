// Public opaque transport: anyone can publish KeyPackages and group envelopes.
// Ephemeral envelope authors need no account authentication on open writes.
// Clients hold the MLS keys; gift wraps keep their recipient checks.
{
  "$schema": "https://bind.ws/relay-config.schema.json",
  "format": "bind.ws/relay-config/2",
  "template": {
    "title": "Marmot",
    "about": "Public Marmot transport. Anyone publishes KeyPackages and opaque group messages; gift wraps keep their recipient checks. Relay write limits still apply."
  },
  "policy": {
    "writes": "open",
    "reads": "open",
    "directoryPublic": true,
    "features": { "marmot": true }
  },
  "kinds": {
    "allow": [10002, 10050, 1059, 30443, 445],
    "block": []
  },
  "retention": [],
  "connections": [
    {"template": "marmot", "visibility": "public"}
  ]
}
