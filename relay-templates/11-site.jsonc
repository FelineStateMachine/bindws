// A static website host: publishers post NIP-5A manifests and upload their
// files through Blossom. The relay mirrors files named by each manifest so
// the site's hostname remains available even when the publisher's server is
// offline. Site manifests have no special retention rule and follow the
// relay's normal event lifetime. Members are the publishers on this relay.
{
  "$schema": "https://bind.ws/relay-config.schema.json",
  "format": "bind.ws/relay-config/2",
  "template": {
    "title": "Sites",
    "about": "A static website host. Members publish NIP-5A manifests and files; the relay mirrors missing files into its own Blossom store."
  },
  "policy": {
    "writes": "allowlist",
    "reads": "open",
    "directoryPublic": true,
    "features": {
      "files": true,
      "sites": { "enabled": true, "mirror": true }
    }
  },
  "kinds": {
    "allow": [],
    "block": []
  },
  "retention": []
}
