// A rules reset: open writes and reads, every kind, kept forever.
// Omitted feature settings stay as they are, including after Quiet.
{
  "$schema": "https://bind.ws/relay-config.schema.json",
  "format": "bind.ws/relay-config/2",
  "template": {
    "title": "Default",
    "about": "Anyone writes, anyone reads, every kind, kept forever. Feature settings stay as they are."
  },
  "policy": {
    "writes": "open",
    "reads": "open",
    "directoryPublic": true
  },
  "kinds": {
    "allow": [],
    "block": []
  },
  "retention": []
}
